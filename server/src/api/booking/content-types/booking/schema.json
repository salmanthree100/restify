{
  "kind": "collectionType",
  "collectionName": "bookings",
  "info": {
    "singularName": "booking",
    "pluralName": "bookings",
    "displayName": "Booking",
    "description": "Property reservations for date availability filtering"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "checkIn": {
      "type": "date",
      "required": true
    },
    "checkOut": {
      "type": "date",
      "required": true
    },
    "bookingStatus": {
      "type": "enumeration",
      "required": true,
      "default": "confirmed",
      "enum": [
        "pending",
        "confirmed",
        "cancelled"
      ]
    },
    "totalPrice": {
      "type": "decimal"
    },
    "guestsCount": {
      "type": "integer"
    },
    "property": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::property.property",
      "inversedBy": "bookings"
    }
  }
}
